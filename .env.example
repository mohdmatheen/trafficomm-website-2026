# Copy to .env.local for local development. Never commit real values.

# Public canonical origin used for metadata, sitemap and structured data.
# Leave unset locally (defaults to http://localhost:3000). Set per environment on Vercel.
NEXT_PUBLIC_SITE_URL=

# --- Assessment form delivery ------------------------------------------------
# Every valid submission is delivered to EVERY channel configured below. Set at
# least one, or production returns 503 rather than silently dropping a lead.
# All of these are server-only: no NEXT_PUBLIC_ prefix, so none reaches the browser.

# 1) Email. "postmark" or "resend".
#    Postmark needs a confirmed Sender Signature for ASSESSMENT_EMAIL_FROM (a link
#    clicked in that mailbox — no DNS change required to start).
#    Resend requires a verified sending domain, which does mean DNS records.
ASSESSMENT_EMAIL_PROVIDER=
# Postmark: Server API token. Resend: API key (re_...). Secret — set it in the
# Vercel dashboard, never in a committed file.
ASSESSMENT_EMAIL_API_KEY=
# The From address. Must be a sender the provider has verified.
# Accepts "Name <address@example.com>".
ASSESSMENT_EMAIL_FROM=
# Where assessment enquiries are delivered. Kept out of the repository because
# this repository is public and a committed business address gets harvested.
ASSESSMENT_EMAIL_TO=

# 2) Webhook. Each submission is POSTed here as JSON (CRM, Slack, HubSpot, or an
#    email relay such as Zapier / Make / n8n / Pipedream). The payload carries
#    ready-made `subject`, `replyTo` and `text` fields, so a relay can send the
#    notification without composing it.
ASSESSMENT_WEBHOOK_URL=

# Search-engine indexing. Leave UNSET on previews and on the *.vercel.app project URL
# (default: noindex, nofollow everywhere). Set to "true" ONLY in the Production
# environment of the real trafficomm.com launch.
SITE_INDEXABLE=

# --- Lead store --------------------------------------------------------------
# Postgres. Provisioned through the Vercel Marketplace (Neon), which injects this
# into Production, Preview and Development automatically. Preview gets its own
# Neon branch, so preview leads can never reach production rows.
# Apply the schema with `npm run db:migrate` against each environment's URL.
# Server-only. If unset, the site still runs and forms still deliver by email —
# leads simply are not stored.
DATABASE_URL=

# --- Internal lead dashboard (/admin) ----------------------------------------
# Signs the one-time sign-in links and the session cookie. Any long random
# string; rotate it to invalidate every existing session at once.
#   openssl rand -base64 48
# Without it, /admin denies everyone — an unconfigured deployment is closed,
# not open.
ADMIN_AUTH_SECRET=
# Who may sign in. Comma- or whitespace-separated, case-insensitive.
# Sign-in links are delivered through ASSESSMENT_EMAIL_* above, so no additional
# provider is involved. Removing an address locks it out immediately, without
# waiting for the session to expire.
ADMIN_ALLOWED_EMAILS=

# --- LinkedIn (NOT IMPLEMENTED) ----------------------------------------------
# Listed so the shape is agreed, not because anything reads them yet. No LinkedIn
# integration exists in the codebase: no Insight Tag, no Conversions API, no Lead
# Sync. These are placeholders for the next phase and must stay unset until then.
# FEATURE_LINKEDIN_CAPI=false
# FEATURE_LINKEDIN_LEADSYNC=false
